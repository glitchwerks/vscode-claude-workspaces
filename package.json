{
  "name": "vscode-claude-workspaces",
  "displayName": "Claude Workspaces",
  "description": "Manage workspace-aware Claude Code sessions across VS Code multi-root workspaces.",
  "version": "0.11.2",
  "publisher": "cbeaulieu-gt",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/glitchwerks/vscode-claude-workspaces.git"
  },
  "bugs": {
    "url": "https://github.com/glitchwerks/vscode-claude-workspaces/issues"
  },
  "homepage": "https://github.com/glitchwerks/vscode-claude-workspaces#readme",
  "icon": "media/claude-workspaces-icon.png",
  "engines": {
    "vscode": "^1.128.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "claude",
    "multi-root",
    "workspace"
  ],
  "main": "./dist/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "scripts": {
    "build": "node esbuild.js",
    "build:production": "node esbuild.js --production",
    "check:types": "tsc --noEmit",
    "compile:tests": "node scripts/patch-node-pty.js && tsc --outDir out --sourceMap",
    "lint": "eslint src test .vscode-test.js",
    "test:unit": "npm run compile:tests && mocha \"out/test/unit/**/*.test.js\"",
    "test:release-policy": "npm run compile:tests && mocha \"out/test/unit/changelog.test.js\" \"out/test/unit/guardChannel.test.js\" \"out/test/unit/releaseMetadata.test.js\" \"out/test/unit/releasePolicy.test.js\" \"out/test/unit/validateReleaseSource.test.js\" \"out/test/unit/releaseWorkflow.test.js\" \"out/test/unit/releaseEnforcement*.test.js\"",
    "test:integration": "npm run build && npm run compile:tests && vscode-test",
    "measure:terminal-echo": "npm run compile:tests && vscode-test --config .vscode-test-terminal-echo.cjs",
    "test": "npm run test:unit && npm run test:integration",
    "package:stable": "node scripts/guard-channel.js stable && npm run build:production && vsce package --target win32-x64 --out dist/claude-workspaces-win32-x64.vsix",
    "package:prerelease": "node scripts/guard-channel.js prerelease && npm run build:production && vsce package --pre-release --target win32-x64 --out dist/claude-workspaces-win32-x64.vsix",
    "publish:stable": "node scripts/guard-channel.js stable && npm run build:production && vsce publish --target win32-x64",
    "publish:prerelease": "node scripts/guard-channel.js prerelease && npm run build:production && vsce publish --pre-release --target win32-x64"
  },
  "contributes": {
    "commands": [
      {
        "command": "claudeWorkspaces.show",
        "title": "Show Claude Workspaces",
        "category": "Claude Workspaces"
      },
      {
        "command": "claudeWorkspaces.newSession",
        "title": "New Session",
        "category": "Claude Workspaces"
      },
      {
        "command": "claudeWorkspaces.newInFolder",
        "title": "New in Folder…",
        "category": "Claude Workspaces"
      },
      {
        "command": "claudeWorkspaces.closeSession",
        "title": "Close Session",
        "category": "Claude Workspaces"
      },
      {
        "command": "claudeWorkspaces.restartFresh",
        "title": "Restart Fresh",
        "category": "Claude Workspaces"
      },
      {
        "command": "claudeWorkspaces.previousSession",
        "title": "Previous Session",
        "category": "Claude Workspaces"
      },
      {
        "command": "claudeWorkspaces.nextSession",
        "title": "Next Session",
        "category": "Claude Workspaces"
      },
      {
        "command": "claudeWorkspaces.captureTerminalDiagnostics",
        "title": "Capture Terminal Diagnostics",
        "category": "Claude Workspaces"
      },
      {
        "command": "claudeWorkspaces.captureActivityDiagnostics",
        "title": "Capture Activity Diagnostics",
        "category": "Claude Workspaces"
      },
      {
        "command": "claudeWorkspaces.configureWorkspace",
        "title": "Configure Workspace…",
        "category": "Claude Workspaces"
      },
      {
        "command": "claudeWorkspaces.composer.submit",
        "title": "Send prompt",
        "category": "Claude Workspaces"
      },
      {
        "command": "claudeWorkspaces.composer.toggle",
        "title": "Show/hide prompt composer",
        "category": "Claude Workspaces"
      },
      {
        "command": "claudeWorkspaces.composer.focus",
        "title": "Focus prompt composer",
        "category": "Claude Workspaces"
      },
      {
        "command": "claudeWorkspaces.composer.pickCommand",
        "title": "Choose skill or command",
        "category": "Claude Workspaces"
      },
      {
        "command": "claudeWorkspaces.composer.find",
        "title": "Find in prompt",
        "category": "Claude Workspaces"
      },
      {
        "command": "claudeWorkspaces.composer.replace",
        "title": "Replace in prompt",
        "category": "Claude Workspaces"
      },
      {
        "command": "claudeWorkspaces.composer.undo",
        "title": "Undo prompt edit",
        "category": "Claude Workspaces"
      },
      {
        "command": "claudeWorkspaces.composer.redo",
        "title": "Redo prompt edit",
        "category": "Claude Workspaces"
      },
      {
        "command": "claudeWorkspaces.composer.configureShortcuts",
        "title": "Customize prompt shortcuts",
        "category": "Claude Workspaces"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "claudeWorkspaces.captureTerminalDiagnostics",
          "when": "claudeWorkspaces.savedWorkspace"
        },
        {
          "command": "claudeWorkspaces.captureActivityDiagnostics",
          "when": "claudeWorkspaces.savedWorkspace"
        },
        {
          "command": "claudeWorkspaces.show",
          "when": "claudeWorkspaces.savedWorkspace"
        },
        {
          "command": "claudeWorkspaces.newSession",
          "when": "claudeWorkspaces.savedWorkspace"
        },
        {
          "command": "claudeWorkspaces.newInFolder",
          "when": "claudeWorkspaces.savedWorkspace"
        },
        {
          "command": "claudeWorkspaces.closeSession",
          "when": "claudeWorkspaces.savedWorkspace"
        },
        {
          "command": "claudeWorkspaces.restartFresh",
          "when": "claudeWorkspaces.savedWorkspace"
        },
        {
          "command": "claudeWorkspaces.previousSession",
          "when": "claudeWorkspaces.savedWorkspace"
        },
        {
          "command": "claudeWorkspaces.nextSession",
          "when": "claudeWorkspaces.savedWorkspace"
        },
        {
          "command": "claudeWorkspaces.configureWorkspace",
          "when": "claudeWorkspaces.savedWorkspace"
        },
        {
          "command": "claudeWorkspaces.composer.submit",
          "when": "claudeWorkspaces.savedWorkspace"
        },
        {
          "command": "claudeWorkspaces.composer.toggle",
          "when": "claudeWorkspaces.savedWorkspace"
        },
        {
          "command": "claudeWorkspaces.composer.focus",
          "when": "claudeWorkspaces.savedWorkspace"
        },
        {
          "command": "claudeWorkspaces.composer.pickCommand",
          "when": "claudeWorkspaces.savedWorkspace"
        },
        {
          "command": "claudeWorkspaces.composer.find",
          "when": "claudeWorkspaces.savedWorkspace"
        },
        {
          "command": "claudeWorkspaces.composer.replace",
          "when": "claudeWorkspaces.savedWorkspace"
        },
        {
          "command": "claudeWorkspaces.composer.undo",
          "when": "claudeWorkspaces.savedWorkspace"
        },
        {
          "command": "claudeWorkspaces.composer.redo",
          "when": "claudeWorkspaces.savedWorkspace"
        },
        {
          "command": "claudeWorkspaces.composer.configureShortcuts",
          "when": "claudeWorkspaces.savedWorkspace"
        }
      ]
    },
    "viewsContainers": {
      "panel": [
        {
          "id": "claudeWorkspaces",
          "title": "Claude Workspaces",
          "icon": "media/claude-workspaces.svg"
        }
      ]
    },
    "views": {
      "claudeWorkspaces": [
        {
          "id": "claudeWorkspaces.sessions",
          "name": "Sessions",
          "type": "webview",
          "when": "claudeWorkspaces.savedWorkspace"
        }
      ]
    },
    "configuration": {
      "title": "Claude Workspaces",
      "properties": {
        "claudeWorkspaces.claudeExecutable": {
          "type": "string",
          "description": "Optional path or command used to launch Claude Code."
        },
        "claudeWorkspaces.sessionSidebarPosition": {
          "type": "string",
          "enum": [
            "left",
            "right"
          ],
          "default": "right",
          "scope": "window",
          "description": "Places the session action sidebar to the left or right of the terminal. Changes apply immediately."
        },
        "claudeWorkspaces.sessionSidebarInitiallyExpanded": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "Starts the session action sidebar expanded in a newly opened Sessions view. Disable to start with collapsed icon buttons."
        },
        "claudeWorkspaces.sessionDetailsInitiallyExpanded": {
          "type": "boolean",
          "default": true,
          "description": "Controls whether session launch details are expanded when the Sessions view first opens."
        },
        "claudeWorkspaces.waitingSessionNotifications": {
          "type": "boolean",
          "default": true,
          "description": "Controls native Windows notifications when a managed background session needs input."
        },
        "claudeWorkspaces.logLevel": {
          "type": "string",
          "enum": [
            "off",
            "error",
            "warn",
            "info",
            "debug",
            "trace"
          ],
          "default": "info",
          "description": "Controls diagnostic verbosity in the Claude Workspaces Output channel."
        }
      }
    },
    "keybindings": [
      {
        "command": "claudeWorkspaces.composer.submit",
        "key": "ctrl+enter",
        "when": "claudeWorkspaces.savedWorkspace && claudeWorkspaces.viewFocused && claudeWorkspaces.composerFocused && !claudeWorkspaces.composerPickerFocused"
      },
      {
        "command": "claudeWorkspaces.composer.toggle",
        "key": "ctrl+g",
        "when": "claudeWorkspaces.savedWorkspace && claudeWorkspaces.viewFocused"
      },
      {
        "command": "claudeWorkspaces.composer.find",
        "key": "ctrl+f",
        "when": "claudeWorkspaces.savedWorkspace && claudeWorkspaces.viewFocused && claudeWorkspaces.composerFocused && !claudeWorkspaces.composerPickerFocused"
      },
      {
        "command": "claudeWorkspaces.composer.replace",
        "key": "ctrl+h",
        "when": "claudeWorkspaces.savedWorkspace && claudeWorkspaces.viewFocused && claudeWorkspaces.composerFocused && !claudeWorkspaces.composerPickerFocused"
      },
      {
        "command": "claudeWorkspaces.composer.undo",
        "key": "ctrl+z",
        "when": "claudeWorkspaces.savedWorkspace && claudeWorkspaces.viewFocused && claudeWorkspaces.composerFocused && !claudeWorkspaces.composerPickerFocused"
      },
      {
        "command": "claudeWorkspaces.composer.redo",
        "key": "ctrl+y",
        "when": "claudeWorkspaces.savedWorkspace && claudeWorkspaces.viewFocused && claudeWorkspaces.composerFocused && !claudeWorkspaces.composerPickerFocused"
      }
    ]
  },
  "dependencies": {
    "node-pty": "1.1.0"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@eslint/js": "10.0.1",
    "@types/jsdom": "^30.0.0",
    "@types/mocha": "10.0.10",
    "@types/node": "20.19.43",
    "@types/vscode": "1.120.0",
    "@vscode/test-cli": "0.0.15",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "3.9.2",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "esbuild": "0.28.2",
    "eslint": "10.9.1",
    "js-yaml": "4.3.1",
    "jsdom": "^29.1.1",
    "markdown-it": "15.0.3",
    "minimatch": "10.2.6",
    "mocha": "11.8.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0"
  }
}
